-Daether.remoteRepositoryFilter.groupId=true
-Daether.remoteRepositoryFilter.groupId.basedir=${session.rootDirectory}/.mvn/rrf/



# Scalpel Configuration for Incremental Builds
# Note: Scalpel is disabled by default. Enable in CI with -Dscalpel.enabled=true
# baseBranch is auto-detected from GitHub environment variables (GITHUB_BASE_REF)
-Dscalpel.mode=report
-Dscalpel.fetchBaseBranch=true
-Dscalpel.reportFile=target/scalpel-report.json
-Dscalpel.impactedLog=target/scalpel-impacted.log
-Dscalpel.failSafe=true
-Dscalpel.buildAllIfNoChanges=true
-Dscalpel.disableOnBranch=main,camel-main,quarkus-main,\d+\.\d+\.x
-Dscalpel.fullBuildTriggers=.mvn/**,pom.xml,poms/**,tooling/scripts/test-categories.yaml,.github/workflows/ci-build.yaml
