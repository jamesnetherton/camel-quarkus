-Daether.remoteRepositoryFilter.groupId=true
-Daether.remoteRepositoryFilter.groupId.basedir=${session.rootDirectory}/.mvn/rrf/

# Scalpel incremental build configuration
# Mode: report = generate JSON report without modifying build
# alsoMakeDependents: include modules that depend on changed modules
-Dscalpel.mode=report
-Dscalpel.alsoMakeDependents=true
